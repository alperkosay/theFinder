{
  "name": "@thefinder/ckeditor",
  "version": "0.7.0",
  "description": "theFinder connector for CKEditor 5 and CKEditor 4: a CKFinder replacement to browse files from the toolbar and upload pasted images.",
  "license": "MIT",
  "author": "Alper Koşay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperkosay/thefinder.git",
    "directory": "packages/ckeditor"
  },
  "homepage": "https://alperkosay.github.io/theFinder/docs/ckeditor.html",
  "bugs": "https://github.com/alperkosay/thefinder/issues",
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "ckeditor4",
    "ckfinder",
    "ckfinder-alternative",
    "file-manager",
    "file-browser",
    "image-upload",
    "rich-text-editor"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./v4": {
      "types": "./dist/v4.d.ts",
      "import": "./dist/v4.js",
      "require": "./dist/v4.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@thefinder/core": "0.7.0",
    "@thefinder/react": "0.7.0"
  },
  "peerDependencies": {
    "ckeditor5": ">=42",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "ckeditor5": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
