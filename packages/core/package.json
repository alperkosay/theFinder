{
  "name": "@thefinder/core",
  "version": "0.5.0",
  "description": "theFinder server engine: a framework-agnostic file manager backend with local disk and S3 storage, chunked uploads, zip, trash and version history. Zero dependencies.",
  "license": "MIT",
  "author": "Alper Koşay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperkosay/thefinder.git",
    "directory": "packages/core"
  },
  "homepage": "https://alperkosay.github.io/theFinder/docs/core.html",
  "bugs": "https://github.com/alperkosay/thefinder/issues",
  "keywords": [
    "file-manager",
    "file-browser",
    "elfinder",
    "ckfinder",
    "s3",
    "r2",
    "minio",
    "upload",
    "chunked-upload",
    "zip",
    "thumbnails",
    "trash",
    "version-history",
    "express",
    "fastify",
    "koa",
    "hono",
    "bun",
    "nodejs",
    "edge"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js",
      "require": "./dist/local.cjs"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js",
      "require": "./dist/s3.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./sharp": {
      "types": "./dist/sharp.d.ts",
      "import": "./dist/sharp.js",
      "require": "./dist/sharp.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:bun": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "test:s3": "vitest run test/s3.integration.test.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
