{
  "name": "@thefinder/react",
  "version": "0.5.1",
  "description": "theFinder React UI: a fast, keyboard-friendly file manager and file picker, written in plain CSS. Code, Markdown and image editors built in.",
  "license": "MIT",
  "author": "Alper Koşay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alperkosay/thefinder.git",
    "directory": "packages/react"
  },
  "homepage": "https://alperkosay.github.io/theFinder/",
  "bugs": "https://github.com/alperkosay/thefinder/issues",
  "keywords": [
    "file-manager",
    "file-browser",
    "file-picker",
    "file-explorer",
    "react",
    "react-component",
    "elfinder",
    "ckfinder",
    "finder",
    "upload",
    "code-editor",
    "image-editor",
    "media-library"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup && node ./scripts/copy-css.mjs",
    "dev": "tsup --watch --onSuccess \"node ./scripts/copy-css.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@thefinder/core": "0.5.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
